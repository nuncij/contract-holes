{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://contract-holes.dev/schemas/bounty-source-manifest-1.0.schema.json",
  "title": "Contract Holes bounty source manifest 1.0",
  "type": "object",
  "required": [
    "schema_version",
    "scanner_version",
    "profile_sha256",
    "source",
    "scope_paths",
    "files",
    "source_set_sha256",
    "compiler",
    "manifest_sha256"
  ],
  "properties": {
    "schema_version": { "const": "1.0" },
    "scanner_version": { "type": "string", "minLength": 1 },
    "profile_sha256": { "$ref": "#/$defs/digest" },
    "source": { "type": "object" },
    "scope_paths": {
      "type": "array",
      "minItems": 1,
      "items": { "type": "string", "minLength": 1 },
      "uniqueItems": true
    },
    "files": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "required": ["path", "sha256", "bytes"],
        "properties": {
          "path": { "type": "string", "minLength": 1 },
          "sha256": { "$ref": "#/$defs/digest" },
          "bytes": { "type": "integer", "minimum": 0 }
        },
        "additionalProperties": false
      }
    },
    "source_set_sha256": { "$ref": "#/$defs/digest" },
    "compiler": { "type": "object" },
    "manifest_sha256": { "$ref": "#/$defs/digest" }
  },
  "$defs": {
    "digest": { "type": "string", "pattern": "^[0-9a-f]{64}$" }
  },
  "additionalProperties": false
}
