{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://contract-holes.dev/schemas/bounty-report-input-1.0.schema.json",
  "title": "Contract Holes reviewer report input 1.0",
  "type": "object",
  "required": [
    "summary",
    "technical_details",
    "preconditions",
    "reproduction_steps",
    "remediation",
    "limitations",
    "unresolved_questions",
    "duplicate_check",
    "proof_status_explanation",
    "program_rules_rechecked_on"
  ],
  "properties": {
    "summary": { "type": "string", "minLength": 1 },
    "technical_details": { "type": "string", "minLength": 1 },
    "preconditions": { "type": "array", "minItems": 1, "items": { "type": "string", "minLength": 1 } },
    "reproduction_steps": { "type": "array", "minItems": 1, "items": { "type": "string", "minLength": 1 } },
    "remediation": { "type": "string", "minLength": 1 },
    "limitations": { "type": "array", "minItems": 1, "items": { "type": "string", "minLength": 1 } },
    "unresolved_questions": { "type": "array", "items": { "type": "string", "minLength": 1 } },
    "duplicate_check": { "type": "string", "minLength": 1 },
    "proof_status_explanation": { "type": "string", "minLength": 1 },
    "program_rules_rechecked_on": { "type": "string", "format": "date" }
  },
  "additionalProperties": false
}
