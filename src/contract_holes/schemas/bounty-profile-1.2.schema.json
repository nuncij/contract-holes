{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://contract-holes.dev/schemas/bounty-profile-1.2.schema.json",
  "title": "Contract Holes normalized bounty profile 1.2",
  "type": "object",
  "required": [
    "schema_version",
    "profile_sha256",
    "program",
    "source",
    "scope",
    "compiler"
  ],
  "properties": {
    "schema_version": { "const": "1.2" },
    "profile_sha256": { "$ref": "#/$defs/digest" },
    "program": {
      "type": "object",
      "required": [
        "name",
        "platform",
        "rules_url",
        "reviewed_on",
        "authorization_acknowledged",
        "authorization_note"
      ],
      "properties": {
        "name": { "$ref": "#/$defs/text" },
        "platform": { "$ref": "#/$defs/text" },
        "rules_url": { "type": "string", "pattern": "^https://" },
        "reviewed_on": { "type": "string", "format": "date" },
        "authorization_acknowledged": { "const": true },
        "authorization_note": { "$ref": "#/$defs/text" }
      },
      "additionalProperties": false
    },
    "source": {
      "type": "object",
      "required": ["kind", "root"],
      "properties": {
        "kind": { "enum": ["git", "directory"] },
        "root": { "$ref": "#/$defs/text" },
        "revision": {
          "type": "string",
          "pattern": "^(?:[0-9a-f]{40}|[0-9a-f]{64})$"
        },
        "content_sha256": { "$ref": "#/$defs/digest" }
      },
      "additionalProperties": false,
      "oneOf": [
        {
          "properties": { "kind": { "const": "git" } },
          "required": ["revision"],
          "not": { "required": ["content_sha256"] }
        },
        {
          "properties": { "kind": { "const": "directory" } },
          "required": ["content_sha256"],
          "not": { "required": ["revision"] }
        }
      ]
    },
    "scope": {
      "type": "object",
      "required": ["paths", "impacts", "restrictions"],
      "properties": {
        "paths": { "$ref": "#/$defs/nonemptyUniqueTextArray" },
        "impacts": { "$ref": "#/$defs/nonemptyTextArray" },
        "restrictions": {
          "type": "array",
          "items": { "$ref": "#/$defs/text" }
        }
      },
      "additionalProperties": false
    },
    "compiler": {
      "type": "object",
      "required": ["enabled", "offline", "version"],
      "properties": {
        "enabled": { "const": true },
        "offline": { "const": true },
        "version": {
          "type": "string",
          "pattern": "^0\\.8\\.(?:2[0-9]|3[0-6])$"
        },
        "dependency_paths": { "$ref": "#/$defs/nonemptyUniqueTextArray" }
      },
      "additionalProperties": false
    }
  },
  "$defs": {
    "digest": { "type": "string", "pattern": "^[0-9a-f]{64}$" },
    "text": { "type": "string", "minLength": 1 },
    "nonemptyUniqueTextArray": {
      "type": "array",
      "minItems": 1,
      "items": { "$ref": "#/$defs/text" },
      "uniqueItems": true
    },
    "nonemptyTextArray": {
      "type": "array",
      "minItems": 1,
      "items": { "$ref": "#/$defs/text" }
    }
  },
  "additionalProperties": false
}
