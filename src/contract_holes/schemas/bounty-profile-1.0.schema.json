{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://contract-holes.dev/schemas/bounty-profile-1.0.schema.json",
  "title": "Contract Holes normalized bounty profile 1.0",
  "type": "object",
  "required": [
    "schema_version",
    "profile_sha256",
    "program",
    "source",
    "scope",
    "compiler"
  ],
  "properties": {
    "schema_version": { "const": "1.0" },
    "profile_sha256": { "type": "string", "pattern": "^[0-9a-f]{64}$" },
    "program": {
      "type": "object",
      "required": [
        "name",
        "platform",
        "rules_url",
        "reviewed_on",
        "authorization_acknowledged",
        "authorization_note"
      ],
      "additionalProperties": false
    },
    "source": {
      "type": "object",
      "required": ["kind", "root"],
      "additionalProperties": false
    },
    "scope": {
      "type": "object",
      "required": ["paths", "impacts", "restrictions"],
      "additionalProperties": false
    },
    "compiler": {
      "type": "object",
      "required": ["enabled", "offline"],
      "additionalProperties": false
    }
  },
  "additionalProperties": false
}
