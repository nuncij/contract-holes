{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://contract-holes.dev/schemas/bounty-proof-1.0.schema.json",
  "title": "Contract Holes bounty proof manifest 1.0",
  "type": "object",
  "required": [
    "schema_version",
    "candidate_id",
    "profile_sha256",
    "source_manifest_sha256",
    "candidates_sha256",
    "observation_sha256",
    "finding",
    "execution_policy",
    "compiler",
    "generator",
    "requirements",
    "impact_assertion",
    "generated_files",
    "proof_sha256"
  ],
  "properties": {
    "schema_version": { "const": "1.0" },
    "candidate_id": { "type": "string", "pattern": "^BNT-[0-9a-f]{24}$" },
    "profile_sha256": { "$ref": "#/$defs/digest" },
    "source_manifest_sha256": { "$ref": "#/$defs/digest" },
    "candidates_sha256": { "$ref": "#/$defs/digest" },
    "observation_sha256": { "$ref": "#/$defs/digest" },
    "finding": { "type": "object" },
    "execution_policy": { "type": "object" },
    "compiler": { "type": "object" },
    "generator": { "type": "object" },
    "requirements": { "type": "object" },
    "impact_assertion": { "type": "object" },
    "generated_files": { "type": "array" },
    "proof_sha256": { "$ref": "#/$defs/digest" }
  },
  "$defs": {
    "digest": { "type": "string", "pattern": "^[0-9a-f]{64}$" }
  },
  "additionalProperties": false
}
