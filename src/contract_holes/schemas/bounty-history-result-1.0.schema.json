{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://contract-holes.dev/schemas/bounty-history-result-1.0.schema.json",
  "title": "Contract Holes historical bounty evaluation result 1.0",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "evaluation_version",
    "corpus_version",
    "scanner_version",
    "solc_version",
    "labels_frozen_on",
    "labels_sha256",
    "execution_policy",
    "corpus",
    "thresholds",
    "metrics",
    "split_metrics",
    "gate_checks",
    "product_claim",
    "cases",
    "limitations",
    "status",
    "result_sha256"
  ],
  "properties": {
    "schema_version": {"const": "1.0"},
    "evaluation_version": {"const": "1.0"},
    "corpus_version": {"type": "string", "minLength": 1},
    "scanner_version": {"type": "string", "minLength": 1},
    "solc_version": {"type": "string", "minLength": 1},
    "labels_frozen_on": {"type": "string", "format": "date"},
    "labels_sha256": {"type": "string", "pattern": "^[0-9a-f]{64}$"},
    "execution_policy": {"type": "object"},
    "corpus": {"type": "object"},
    "thresholds": {"type": "object"},
    "metrics": {"type": "object"},
    "split_metrics": {"type": "object"},
    "gate_checks": {"type": "object"},
    "product_claim": {"type": "object"},
    "cases": {"type": "array", "minItems": 10},
    "limitations": {"type": "array", "minItems": 1, "items": {"type": "string"}},
    "status": {"enum": ["passed", "failed"]},
    "result_sha256": {"type": "string", "pattern": "^[0-9a-f]{64}$"}
  }
}
