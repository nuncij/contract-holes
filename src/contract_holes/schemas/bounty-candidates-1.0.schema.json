{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://contract-holes.dev/schemas/bounty-candidates-1.0.schema.json",
  "title": "Contract Holes bounty candidate observations 1.0",
  "type": "object",
  "required": [
    "schema_version",
    "profile_sha256",
    "source_manifest_sha256",
    "latest_scan_sha256",
    "candidates",
    "candidates_sha256"
  ],
  "properties": {
    "schema_version": { "const": "1.0" },
    "profile_sha256": { "$ref": "#/$defs/digest" },
    "source_manifest_sha256": { "$ref": "#/$defs/digest" },
    "latest_scan_sha256": { "$ref": "#/$defs/digest" },
    "candidates": {
      "type": "array",
      "items": {
        "type": "object",
        "required": [
          "candidate_id",
          "observation",
          "first_seen_scan_sha256",
          "last_seen_scan_sha256",
          "active"
        ],
        "properties": {
          "candidate_id": { "type": "string", "pattern": "^BNT-[0-9a-f]{24}$" },
          "observation": { "type": "object" },
          "first_seen_scan_sha256": { "$ref": "#/$defs/digest" },
          "last_seen_scan_sha256": { "$ref": "#/$defs/digest" },
          "active": { "type": "boolean" }
        },
        "additionalProperties": false
      }
    },
    "candidates_sha256": { "$ref": "#/$defs/digest" }
  },
  "$defs": {
    "digest": { "type": "string", "pattern": "^[0-9a-f]{64}$" }
  },
  "additionalProperties": false
}
