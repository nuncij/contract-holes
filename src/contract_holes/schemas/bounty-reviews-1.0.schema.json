{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://contract-holes.dev/schemas/bounty-reviews-1.0.schema.json",
  "title": "Contract Holes human bounty reviews 1.0",
  "type": "object",
  "required": [
    "schema_version",
    "profile_sha256",
    "source_manifest_sha256",
    "reviews",
    "reviews_sha256"
  ],
  "properties": {
    "schema_version": { "const": "1.0" },
    "profile_sha256": { "$ref": "#/$defs/digest" },
    "source_manifest_sha256": { "$ref": "#/$defs/digest" },
    "reviews": {
      "type": "array",
      "items": {
        "type": "object",
        "required": [
          "candidate_id",
          "state",
          "reason",
          "reviewer",
          "updated_at",
          "impact",
          "history"
        ],
        "properties": {
          "candidate_id": { "type": "string", "pattern": "^BNT-[0-9a-f]{24}$" },
          "state": {
            "enum": ["investigating", "rejected", "confirmed", "approved"]
          },
          "reason": { "type": "string", "minLength": 1 },
          "reviewer": { "type": "string", "minLength": 1 },
          "updated_at": { "type": "string", "minLength": 1 },
          "impact": { "type": ["string", "null"] },
          "history": { "type": "array", "minItems": 1 }
        },
        "additionalProperties": false
      }
    },
    "reviews_sha256": { "$ref": "#/$defs/digest" }
  },
  "$defs": {
    "digest": { "type": "string", "pattern": "^[0-9a-f]{64}$" }
  },
  "additionalProperties": false
}
