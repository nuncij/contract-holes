{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://contract-holes.dev/schemas/bounty-history-manifest-1.0.schema.json",
  "title": "Contract Holes historical bounty corpus manifest 1.0",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "evaluation_version",
    "corpus_version",
    "labels_frozen_on",
    "solc_version",
    "compiler_config",
    "compiler_config_sha256",
    "thresholds",
    "methodology",
    "cases"
  ],
  "properties": {
    "schema_version": {"const": "1.0"},
    "evaluation_version": {"const": "1.0"},
    "corpus_version": {"type": "string", "minLength": 1},
    "labels_frozen_on": {"type": "string", "format": "date"},
    "solc_version": {"type": "string", "pattern": "^[0-9]+\\.[0-9]+\\.[0-9]+$"},
    "compiler_config": {"type": "string", "minLength": 1},
    "compiler_config_sha256": {"type": "string", "pattern": "^[0-9a-f]{64}$"},
    "thresholds": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "minimum_candidate_precision",
        "minimum_supported_recall",
        "minimum_evidence_completeness",
        "minimum_supported_cases_with_evidence"
      ],
      "properties": {
        "minimum_candidate_precision": {"type": "number", "minimum": 0, "maximum": 1},
        "minimum_supported_recall": {"type": "number", "minimum": 0, "maximum": 1},
        "minimum_evidence_completeness": {"type": "number", "minimum": 0, "maximum": 1},
        "minimum_supported_cases_with_evidence": {"type": "integer", "minimum": 3}
      }
    },
    "methodology": {
      "type": "object",
      "additionalProperties": false,
      "required": ["fixture_policy", "label_policy", "claim"],
      "properties": {
        "fixture_policy": {"type": "string", "minLength": 1},
        "label_policy": {"type": "string", "minLength": 1},
        "claim": {"type": "string", "minLength": 1}
      }
    },
    "cases": {
      "type": "array",
      "minItems": 10,
      "items": {"$ref": "#/$defs/case"}
    }
  },
  "$defs": {
    "case": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "case_id",
        "split",
        "project",
        "title",
        "incident_on",
        "disclosed_on",
        "root_cause",
        "model_status",
        "support_limit",
        "expected_findings",
        "fixture",
        "fixture_sha256",
        "source",
        "disclosure",
        "provenance"
      ],
      "properties": {
        "case_id": {"type": "string", "minLength": 1},
        "split": {"enum": ["calibration", "holdout"]},
        "project": {"type": "string", "minLength": 1},
        "title": {"type": "string", "minLength": 1},
        "incident_on": {"type": "string", "format": "date"},
        "disclosed_on": {"type": "string", "format": "date"},
        "root_cause": {"type": "string", "minLength": 1},
        "model_status": {"enum": ["supported", "out-of-model"]},
        "support_limit": {"type": "string", "minLength": 1},
        "expected_findings": {
          "type": "array",
          "items": {
            "type": "object",
            "additionalProperties": false,
            "required": ["rule_id"],
            "properties": {
              "rule_id": {"type": "string", "pattern": "^SOL[0-9]{3}$"},
              "metadata": {"type": "object"}
            }
          }
        },
        "fixture": {"type": "string", "pattern": "^[^/].*\\.sol$"},
        "fixture_sha256": {"type": "string", "pattern": "^[0-9a-f]{64}$"},
        "source": {"$ref": "#/$defs/source"},
        "disclosure": {"$ref": "#/$defs/disclosure"},
        "provenance": {"$ref": "#/$defs/provenance"}
      }
    },
    "source": {
      "type": "object",
      "additionalProperties": false,
      "required": ["kind", "url", "immutable_id", "redistribution"],
      "properties": {
        "kind": {"type": "string", "minLength": 1},
        "url": {"type": "string", "format": "uri", "pattern": "^https://"},
        "immutable_id": {"type": "string", "minLength": 1},
        "redistribution": {"type": "string", "minLength": 1}
      }
    },
    "disclosure": {
      "type": "object",
      "additionalProperties": false,
      "required": ["publisher", "url", "retrieved_on"],
      "properties": {
        "publisher": {"type": "string", "minLength": 1},
        "url": {"type": "string", "format": "uri", "pattern": "^https://"},
        "retrieved_on": {"type": "string", "format": "date"}
      }
    },
    "provenance": {
      "type": "object",
      "additionalProperties": false,
      "required": ["fixture_kind", "fixture_license", "upstream_code_copied"],
      "properties": {
        "fixture_kind": {"const": "locally-authored-reduction"},
        "fixture_license": {"const": "MIT"},
        "upstream_code_copied": {"const": false}
      }
    }
  }
}

